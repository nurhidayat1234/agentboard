# Copy to .env (never commit .env — it is gitignored).
# Deployer private key for BSC Testnet / mainnet deploys.
# Testnet-only key generated for this project lives in deployer-testnet-key.txt (chmod 600, never printed in chat).
DEPLOYER_PRIVATE_KEY=0x...

# Agent key for scripts/agent/*.js (plain-EVM signing path). Only used when you
# run a write script with --execute. Never print it, never share it, never
# commit .env. If you use the Agentic Wallet (baw) path instead, leave this empty.
AGENT_PRIVATE_KEY=0x...
